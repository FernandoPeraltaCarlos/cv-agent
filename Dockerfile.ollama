# Download the pinned upstream distribution, retain only CPU binaries/libraries.
FROM debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4 AS engine
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl zstd \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fL --retry 2 https://github.com/ollama/ollama/releases/download/v0.40.13/ollama-linux-amd64.tar.zst -o /tmp/ollama.tar.zst \
    && echo 'c9490e0f520be21271d969e6703f012268b1d39f8b70dd58854e5bfef7a75bb6  /tmp/ollama.tar.zst' | sha256sum --check \
    && mkdir -p /opt/engine \
    && tar --zstd -xf /tmp/ollama.tar.zst -C /opt/engine --wildcards --no-wildcards-match-slash \
       bin/ollama 'lib/ollama/*.so*' lib/ollama/llama-server 'lib/ollama/*LICENSE*' 'lib/ollama/*NOTICE*' \
    && rm /tmp/ollama.tar.zst

FROM debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 libgomp1 passwd \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1001 agent && useradd --uid 1001 --gid agent --create-home agent \
    && mkdir -p /models /home/agent/.ollama && chown -R 1001:1001 /models /home/agent
COPY --from=engine /opt/engine/bin/ollama /usr/bin/ollama
COPY --from=engine /opt/engine/lib/ollama /usr/lib/ollama
ENV OLLAMA_MODELS=/models OLLAMA_HOST=0.0.0.0:11434 OLLAMA_NO_CLOUD=1 OLLAMA_NOHISTORY=1 OLLAMA_NUM_PARALLEL=1 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_MAX_QUEUE=1
USER 1001:1001
WORKDIR /home/agent
EXPOSE 11434
ENTRYPOINT ["/usr/bin/ollama"]
CMD ["serve"]
